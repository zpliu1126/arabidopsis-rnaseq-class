{
  "name": "RNA seq class",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-toolsai.jupyter", "ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/rnaseq-python/bin/python"
      }
    }
  }
}
